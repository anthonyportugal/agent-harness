# Agent Harness Cognitive Tier Configuration Template
# Copy or link this file to ~/.config/agent-harness/models.env for local overrides.
# These environment variables map abstract cognitive tiers to the frontier models
# available in your environment, insulating repository rules from model turnover.

# TIER_ARCHITECT: Deep reasoning, architectural planning, and systems design
HARNESS_ARCHITECT_MODEL="google/gemini-3.8-flash-high"
# Common alternatives:
# - Anthropic: "anthropic/claude-opus-5-5" or "anthropic/claude-sonnet-5-5"
# - OpenAI:    "openai/gpt-6.1-sol" or "openai/gpt-6-astra"
# - Antigravity CLI: "pro" (native alias)

# TIER_WORKER: High throughput, surgical code edits, mechanical refactoring
HARNESS_WORKER_MODEL="google/gemini-3.8-flash-medium"
# Common alternatives:
# - Anthropic: "anthropic/claude-haiku-4-5" or "anthropic/claude-fable-5-1"
# - OpenAI:    "openai/gpt-6-luna" or "openai/gpt-5.6"
# - Antigravity CLI: "flash" (native alias)

# TIER_SENTINEL: Read-only 4R review lens, secrets auditing, lint verification
HARNESS_SENTINEL_MODEL="google/gemini-3.8-flash-low"
# Common alternatives:
# - Open Source: "openai/gpt-oss-120b-medium"
# - Antigravity CLI: "flash_lite" (native alias)
