#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME=${0##*/}
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd -P)

COMMAND=${1:-help}
shift || true

usage() {
  cat <<EOF
Usage:
  $PROGRAM_NAME plan                       Show active harness architecture and target runtimes
  $PROGRAM_NAME doctor                     Verify local dependencies, toolchains, and catalog
  $PROGRAM_NAME status                     Display repository and runtime status
  $PROGRAM_NAME rules assemble [FILE]      Compile modular rules into a single markdown document
  $PROGRAM_NAME mcp list                   List registered MCP servers in catalog
  $PROGRAM_NAME mcp config [TARGET]        Export MCP config (generic|claude|antigravity-cli|codex|opencode)
  $PROGRAM_NAME skills list                List curated ambient skills from manifest
  $PROGRAM_NAME skills doctor              Verify status of curated skills in ~/.agents/skills
  $PROGRAM_NAME skills sync                Sync curated skills to ~/.agents/skills
  $PROGRAM_NAME setup [OPTIONS]            Setup and link harness for AI coding agent CLIs

Setup Options:
  --target TARGET   Agent target: antigravity-cli | claude | codex | opencode | all (default: all)
  --deps            Install missing CLI dependencies (codegraph, engram, skills) via pnpm
  --dry-run         Preview file changes and configurations without modifying disk
  -h, --help        Show this help message
EOF
}

setup_colors() {
  if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && (( $(tput colors 2>/dev/null || echo 0) >= 8 )); then
    C_RESET='\033[0m'
    C_BOLD='\033[1m'
    C_PINK='\033[38;2;245;194;231m'
    C_MAUVE='\033[38;2;203;166;247m'
    C_BLUE='\033[38;2;137;180;250m'
    C_GREEN='\033[38;2;166;227;161m'
    C_YELLOW='\033[38;2;249;226;175m'
    C_RED='\033[38;2;243;139;168m'
    C_SUBTEXT='\033[38;2;166;173;200m'
  else
    C_RESET='' C_BOLD='' C_PINK='' C_MAUVE='' C_BLUE=''
    C_GREEN='' C_YELLOW='' C_RED='' C_SUBTEXT=''
  fi
}
setup_colors

info() {
  printf '%b%b[%s]%b %b==>%b %s\n' "$C_MAUVE" "$C_BOLD" "$PROGRAM_NAME" "$C_RESET" "$C_BLUE" "$C_RESET" "$*"
}

success() {
  printf '%b%b[%s]%b %b✓%b %b%s%b\n' "$C_MAUVE" "$C_BOLD" "$PROGRAM_NAME" "$C_RESET" "$C_GREEN" "$C_RESET" "$C_BOLD" "$*" "$C_RESET"
}

warn() {
  printf '%b%b[%s]%b %b%bwarning:%b %s\n' "$C_MAUVE" "$C_BOLD" "$PROGRAM_NAME" "$C_RESET" "$C_YELLOW" "$C_BOLD" "$C_RESET" "$*" >&2
}

error() {
  printf '%b%b[%s]%b %b%berror:%b %s\n' "$C_MAUVE" "$C_BOLD" "$PROGRAM_NAME" "$C_RESET" "$C_RED" "$C_BOLD" "$C_RESET" "$*" >&2
}

die() {
  error "$*"
  exit 1
}

cmd_plan() {
  info "Agent Harness Architecture Plan"
  printf '  %bRepository Root:%b %s\n' "$C_BOLD" "$C_RESET" "$REPO_ROOT"
  printf '  %bArchitecture:%b    %bAmbient Multi-Agent Harness (ODD + 4R + AST + Memory + Skills)%b\n\n' "$C_BOLD" "$C_RESET" "$C_GREEN" "$C_RESET"

  printf '  %bComponents:%b\n' "$C_MAUVE" "$C_RESET"
  printf '    • %bRules:%b   %s/rules\n' "$C_PINK" "$C_RESET" "$REPO_ROOT"
  printf '      - persona.md      (Senior Architect & Mentor identity)\n'
  printf '      - odd.md          (Organic Driven Development lifecycle)\n'
  printf '      - conventions.md  (Gitmoji, pnpm, AUR, Context7 standards)\n'
  printf '      - memory.md       (Engram persistent memory protocol)\n'
  printf '      - review-4r.md    (Risk, Readability, Reliability, Resilience)\n'
  printf '    • %bMCP:%b     %s/mcp\n' "$C_PINK" "$C_RESET" "$REPO_ROOT"
  printf '      - codegraph.json  (AST code intelligence on stdio)\n'
  printf '      - engram.json     (Persistent cross-session memory on stdio)\n'
  printf '    • %bSkills:%b  %s/skills\n' "$C_PINK" "$C_RESET" "$REPO_ROOT"
  printf '      - manifest.json   (Curated skills for documentation, gitmoji, and discovery)\n'
  printf '    • %bTests:%b   %s/tests\n\n' "$C_PINK" "$C_RESET" "$REPO_ROOT"

  printf '  %bTarget Agent CLIs:%b\n' "$C_MAUVE" "$C_RESET"
  printf '    • %bAntigravity CLI%b (antigravity-cli / agy)  %b[https://antigravity.google/cli/install.sh]%b\n' "$C_BLUE" "$C_RESET" "$C_SUBTEXT" "$C_RESET"
  printf '    • %bClaude Code CLI%b (claude)               %b[https://claude.ai/install.sh]%b\n' "$C_BLUE" "$C_RESET" "$C_SUBTEXT" "$C_RESET"
  printf '    • %bOpenAI Codex CLI%b (codex)               %b[https://chatgpt.com/codex/install.sh]%b\n' "$C_BLUE" "$C_RESET" "$C_SUBTEXT" "$C_RESET"
  printf '    • %bOpenCode CLI%b (opencode)                %b[https://opencode.ai/v2/install]%b\n' "$C_BLUE" "$C_RESET" "$C_SUBTEXT" "$C_RESET"
}

cmd_doctor() {
  local missing=0
  local tool

  info "Checking core system dependencies..."
  for tool in bash git curl; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf '  %b[OK]%b %-16s %b%s%b\n' "$C_GREEN" "$C_RESET" "$tool" "$C_SUBTEXT" "$(command -v "$tool")" "$C_RESET"
    else
      printf '  %b[FAIL]%b Missing required tool: %s\n' "$C_RED" "$C_RESET" "$tool" >&2
      missing=$((missing + 1))
    fi
  done

  printf '\n'
  info "Checking agent & semantic toolchains..."
  for tool in pnpm codegraph engram skills jq shellcheck; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf '  %b[OK]%b %-16s %b%s%b\n' "$C_GREEN" "$C_RESET" "$tool" "$C_SUBTEXT" "$(command -v "$tool")" "$C_RESET"
    else
      printf '  %b[INFO]%b Optional tool not found in PATH: %s\n' "$C_BLUE" "$C_RESET" "$tool"
    fi
  done

  printf '\n'
  info "Checking detected Agent CLIs in system..."
  local bin_path
  local -A AGENT_INSTALL_URLS=(
    ["antigravity"]="curl -fsSL https://antigravity.google/cli/install.sh | bash"
    ["claude"]="curl -fsSL https://claude.ai/install.sh | bash"
    ["codex"]="curl -fsSL https://chatgpt.com/codex/install.sh | sh"
    ["opencode"]="curl -fsSL https://opencode.ai/v2/install | bash"
  )

  for tool in antigravity claude codex opencode; do
    bin_path=""
    if [[ "$tool" == "antigravity" ]]; then
      if command -v agy >/dev/null 2>&1; then
        bin_path=$(command -v agy)
      elif command -v antigravity >/dev/null 2>&1; then
        bin_path=$(command -v antigravity)
      fi
    elif [[ "$tool" == "opencode" ]]; then
      if command -v opencode >/dev/null 2>&1; then
        bin_path=$(command -v opencode)
      elif command -v opencode2 >/dev/null 2>&1; then
        bin_path=$(command -v opencode2)
      elif [[ -x "${HOME}/.opencode/bin/opencode" ]]; then
        bin_path="${HOME}/.opencode/bin/opencode"
      fi
    elif command -v "$tool" >/dev/null 2>&1; then
      bin_path=$(command -v "$tool")
    fi

    if [[ -n "$bin_path" ]]; then
      printf '  %b[OK]%b %-16s %b%s%b\n' "$C_GREEN" "$C_RESET" "$tool" "$C_SUBTEXT" "$bin_path" "$C_RESET"
    else
      printf '  %b[INFO]%b %-14s not installed in PATH %b(Install: %s)%b\n' "$C_BLUE" "$C_RESET" "$tool" "$C_SUBTEXT" "${AGENT_INSTALL_URLS[$tool]}" "$C_RESET"
    fi
  done

  printf '\n'
  info "Checking repository rules and catalog integrity..."
  local file
  for file in rules/persona.md rules/odd.md rules/conventions.md rules/memory.md rules/review-4r.md mcp/codegraph.json mcp/engram.json skills/manifest.json; do
    if [[ -f "$REPO_ROOT/$file" ]]; then
      printf '  %b[OK]%b %s\n' "$C_GREEN" "$C_RESET" "$file"
    else
      printf '  %b[FAIL]%b Missing required file: %s\n' "$C_RED" "$C_RESET" "$file" >&2
      missing=$((missing + 1))
    fi
  done

  if (( missing > 0 )); then
    die "Doctor detected $missing missing dependencies or files."
  fi

  printf '\n'
  success "Doctor check passed successfully."
}

cmd_status() {
  info "Agent Harness Environment Status"
  printf '  %bRepository:%b %s\n' "$C_BOLD" "$C_RESET" "$REPO_ROOT"
  printf '  %bBranch:%b     %b%s%b\n' "$C_BOLD" "$C_RESET" "$C_PINK" "$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")" "$C_RESET"
  printf '  %bGit commit:%b %b%s%b\n' "$C_BOLD" "$C_RESET" "$C_BLUE" "$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo "none")" "$C_RESET"
}

cmd_rules() {
  local subcmd=${1:-assemble}
  shift || true

  case "$subcmd" in
    assemble)
      local out_file=${1:-}
      local buffer
      buffer=$(cat <<EOF
# Unified AI Agent Instructions & Governance
<!-- Compiled automatically by agent-harness (https://github.com/anthonyportugal/agent-harness) -->

$(cat "$REPO_ROOT/rules/persona.md")

---

$(cat "$REPO_ROOT/rules/odd.md")

---

$(cat "$REPO_ROOT/rules/conventions.md")

---

$(cat "$REPO_ROOT/rules/memory.md")

---

$(cat "$REPO_ROOT/rules/review-4r.md")
EOF
)
      if [[ -n "$out_file" ]]; then
        mkdir -p "$(dirname "$out_file")"
        printf '%s\n' "$buffer" > "$out_file"
        success "Assembled master rules written to $out_file"
      else
        printf '%s\n' "$buffer"
      fi
      ;;
    *)
      die "Unknown rules subcommand '$subcmd'. Supported: assemble"
      ;;
  esac
}

cmd_mcp() {
  local subcmd=${1:-list}
  shift || true

  case "$subcmd" in
    list)
      info "Registered MCP Servers in Harness Catalog:"
      local json_file name desc
      for json_file in "$REPO_ROOT"/mcp/*.json; do
        [[ -e "$json_file" ]] || continue
        name=$(basename "$json_file" .json)
        if command -v jq >/dev/null 2>&1; then
          desc=$(jq -r '.description // "No description"' "$json_file")
        else
          desc="MCP configuration file: $json_file"
        fi
        printf '  • %b%-12s%b %s\n' "$C_PINK" "$name" "$C_RESET" "$desc"
      done
      ;;
    config)
      local target=${1:-generic}
      case "$target" in
        generic|claude|antigravity-cli|antigravity|codex|opencode)
          if command -v jq >/dev/null 2>&1; then
            jq -n \
              --slurpfile cg "$REPO_ROOT/mcp/codegraph.json" \
              --slurpfile eg "$REPO_ROOT/mcp/engram.json" \
              '{
                mcpServers: {
                  codegraph: {
                    type: $cg[0].transport,
                    command: $cg[0].command,
                    args: $cg[0].args
                  },
                  engram: {
                    type: $eg[0].transport,
                    command: $eg[0].command,
                    args: $eg[0].args
                  }
                }
              }'
          else
            cat <<'JSON'
{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": ["serve", "--mcp"]
    },
    "engram": {
      "type": "stdio",
      "command": "engram",
      "args": ["mcp", "--tools=agent"]
    }
  }
}
JSON
          fi
          ;;
        *)
          die "Unknown target agent '$target'. Supported: generic, claude, antigravity-cli, codex, opencode"
          ;;
      esac
      ;;
    *)
      die "Unknown mcp subcommand '$subcmd'. Supported: list, config"
      ;;
  esac
}

cmd_skills() {
  local subcmd=${1:-list}
  shift || true
  local manifest="$REPO_ROOT/skills/manifest.json"

  [[ -f "$manifest" ]] || die "Missing skills manifest: $manifest"

  case "$subcmd" in
    list)
      info "Curated Ambient Skills Manifest:"
      if command -v jq >/dev/null 2>&1; then
        jq -r '.skills[] | "  • " + (.name | rpad(22)) + (.description // "")' "$manifest" 2>/dev/null || \
          jq -r '.skills[] | "  • " + .name + ": " + .description' "$manifest"
      else
        grep '"name":' "$manifest"
      fi
      ;;
    doctor)
      local skills_dir="${HOME}/.agents/skills"
      info "Verifying curated skills in $skills_dir..."
      if [[ ! -d "$skills_dir" ]]; then
        info "$skills_dir directory does not exist yet."
        return 0
      fi
      if command -v jq >/dev/null 2>&1; then
        local skill_name
        while read -r skill_name; do
          if [[ -d "$skills_dir/$skill_name" ]]; then
            printf '  %b[OK]%b Skill installed: %s\n' "$C_GREEN" "$C_RESET" "$skill_name"
          else
            printf '  %b[INFO]%b Skill not installed in ~/.agents/skills: %s\n' "$C_BLUE" "$C_RESET" "$skill_name"
          fi
        done < <(jq -r '.skills[].name' "$manifest")
      fi
      ;;
    sync)
      info "Syncing curated skills to ~/.agents/skills..."
      local skills_dir="${HOME}/.agents/skills"
      mkdir -p "$skills_dir"
      if command -v pnpm >/dev/null 2>&1; then
        local skill_src skill_name
        while IFS='|' read -r skill_name skill_src; do
          printf '  Syncing skill: %b%s%b (%s)...\n' "$C_PINK" "$skill_name" "$C_RESET" "$skill_src"
          pnpm dlx skills-cli add "$skill_src" --skill "$skill_name" --yes || \
            warn "Failed to sync $skill_name automatically. Run manually."
        done < <(jq -r '.skills[] | .name + "|" + .source' "$manifest")
        success "Skills synchronized to ~/.agents/skills"
      else
        die "pnpm is required to execute skills-cli via pnpm dlx."
      fi
      ;;
    *)
      die "Unknown skills subcommand '$subcmd'. Supported: list, doctor, sync"
      ;;
  esac
}

cmd_setup() {
  local target="all"
  local install_deps=0
  local dry_run=0

  while (( $# > 0 )); do
    case "$1" in
      --target)
        target=${2:-all}
        shift 2
        ;;
      --target=*)
        target=${1#*=}
        shift
        ;;
      --deps)
        install_deps=1
        shift
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown setup option '$1'"
        ;;
    esac
  done

  info "Agent Harness Setup Initiated"
  printf '  %bTarget:%b   %s\n' "$C_BOLD" "$C_RESET" "$target"
  printf '  %bDeps:%b     %s\n' "$C_BOLD" "$C_RESET" "$(( install_deps ? 1 : 0 ))"
  printf '  %bDry Run:%b  %s\n\n' "$C_BOLD" "$C_RESET" "$(( dry_run ? 1 : 0 ))"

  if (( install_deps )); then
    info "Ensuring CLI dependencies via pnpm..."
    if command -v pnpm >/dev/null 2>&1; then
      if (( dry_run )); then
        printf '  [DRY-RUN] Would install @colbymchenry/codegraph and skills-cli globally\n'
      else
        pnpm add -g @colbymchenry/codegraph skills-cli || warn "pnpm global install failed; check permissions"
      fi
    else
      warn "pnpm not found; please install pnpm first"
    fi

    if ! command -v engram >/dev/null 2>&1; then
      info "engram not found in PATH; installing engram from official GitHub releases..."
      local engram_url="https://github.com/Gentleman-Programming/engram/releases/download/v2.2.1/engram_2.2.1_linux_amd64.tar.gz"
      local install_bin_dir="${HOME}/.local/bin"
      if (( dry_run )); then
        printf '  [DRY-RUN] Would download and install engram 2.2.1 to %s/engram\n' "$install_bin_dir"
      else
        mkdir -p "$install_bin_dir"
        local tmp_eg
        tmp_eg=$(mktemp -d)
        if curl -sSL "$engram_url" | tar -xz -C "$tmp_eg" 2>/dev/null && [[ -f "$tmp_eg/engram" ]]; then
          install -m 0755 "$tmp_eg/engram" "$install_bin_dir/engram"
          success "Installed engram 2.2.1 to $install_bin_dir/engram"
        else
          warn "Failed to download or extract engram release from GitHub"
        fi
        rm -rf "$tmp_eg"
      fi
    fi
  fi

  local targets_to_run=()
  case "$target" in
    all)
      targets_to_run=("antigravity-cli" "claude" "codex" "opencode")
      ;;
    antigravity-cli|antigravity)
      targets_to_run=("antigravity-cli")
      ;;
    claude)
      targets_to_run=("claude")
      ;;
    codex)
      targets_to_run=("codex")
      ;;
    opencode)
      targets_to_run=("opencode")
      ;;
    *)
      die "Unknown target '$target'. Supported: antigravity-cli, claude, codex, opencode, all"
      ;;
  esac

  local current_target
  for current_target in "${targets_to_run[@]}"; do
    info "Configuring Agent Runtime: $current_target..."
    case "$current_target" in
      antigravity-cli)
        local agy_cfg="${HOME}/.gemini/antigravity-cli/mcp_config.json"
        local agy_rules="${HOME}/.gemini/antigravity-cli/rules/agent-harness.md"
        local agy_skills_json="${HOME}/.gemini/config/skills.json"
        if (( dry_run )); then
          printf '  [DRY-RUN] Would update MCP servers in %s\n' "$agy_cfg"
          printf '  [DRY-RUN] Would compile rules to %s\n' "$agy_rules"
          printf '  [DRY-RUN] Would configure skills discovery in %s\n' "$agy_skills_json"
        else
          mkdir -p "$(dirname "$agy_cfg")" "$(dirname "$agy_rules")" "$(dirname "$agy_skills_json")" "${HOME}/.gemini/antigravity-cli"
          if [[ -f "$agy_cfg" ]] && command -v jq >/dev/null 2>&1; then
            local tmp_agy
            tmp_agy=$(mktemp)
            jq --slurpfile cg "$REPO_ROOT/mcp/codegraph.json" \
               --slurpfile eg "$REPO_ROOT/mcp/engram.json" \
               '.mcpServers.codegraph = {type: $cg[0].transport, command: $cg[0].command, args: $cg[0].args} |
                .mcpServers.engram = {type: $eg[0].transport, command: $eg[0].command, args: $eg[0].args}' \
               "$agy_cfg" > "$tmp_agy" && mv "$tmp_agy" "$agy_cfg"
            printf '  %b[OK]%b Merged MCP servers into %s\n' "$C_GREEN" "$C_RESET" "$agy_cfg"
          else
            cmd_mcp config antigravity-cli > "$agy_cfg"
            printf '  %b[OK]%b Created %s\n' "$C_GREEN" "$C_RESET" "$agy_cfg"
          fi
          cmd_rules assemble "$agy_rules" >/dev/null
          printf '  %b[OK]%b Installed rules in %s\n' "$C_GREEN" "$C_RESET" "$agy_rules"
          cat > "$agy_skills_json" <<'EOF'
{
  "entries": [
    {
      "path": "~/.agents/skills"
    }
  ]
}
EOF
          ln -sfn "$agy_skills_json" "${HOME}/.gemini/antigravity-cli/skills.json"
          ln -sfn "${HOME}/.agents/skills" "${HOME}/.gemini/config/skills"
          ln -sfn "${HOME}/.agents/skills" "${HOME}/.gemini/antigravity-cli/skills"
          printf '  %b[OK]%b Configured skills discovery in %s\n' "$C_GREEN" "$C_RESET" "$agy_skills_json"
        fi
        ;;
      claude)
        local claude_cfg="${HOME}/.claude.json"
        local claude_rules="${HOME}/.claude/CLAUDE.md"
        if (( dry_run )); then
          printf '  [DRY-RUN] Would update MCP servers in %s\n' "$claude_cfg"
          printf '  [DRY-RUN] Would compile master rules to %s\n' "$claude_rules"
        else
          mkdir -p "$(dirname "$claude_rules")"
          if [[ -f "$claude_cfg" ]] && command -v jq >/dev/null 2>&1; then
            local tmp_claude
            tmp_claude=$(mktemp)
            jq --slurpfile cg "$REPO_ROOT/mcp/codegraph.json" \
               --slurpfile eg "$REPO_ROOT/mcp/engram.json" \
               '.mcpServers.codegraph = {type: $cg[0].transport, command: $cg[0].command, args: $cg[0].args} |
                .mcpServers.engram = {type: $eg[0].transport, command: $eg[0].command, args: $eg[0].args}' \
               "$claude_cfg" > "$tmp_claude" && mv "$tmp_claude" "$claude_cfg"
            printf '  %b[OK]%b Merged MCP servers into %s\n' "$C_GREEN" "$C_RESET" "$claude_cfg"
          else
            cmd_mcp config claude > "$claude_cfg"
            printf '  %b[OK]%b Created %s\n' "$C_GREEN" "$C_RESET" "$claude_cfg"
          fi
          cmd_rules assemble "$claude_rules" >/dev/null
          printf '  %b[OK]%b Installed rules in %s\n' "$C_GREEN" "$C_RESET" "$claude_rules"
        fi
        ;;
      codex)
        local codex_cfg="${HOME}/.codex/config.json"
        local codex_rules="${HOME}/.codex/AGENTS.md"
        if (( dry_run )); then
          printf '  [DRY-RUN] Would update MCP servers in %s\n' "$codex_cfg"
          printf '  [DRY-RUN] Would verify or update rules in %s\n' "$codex_rules"
        else
          mkdir -p "$(dirname "$codex_cfg")"
          if [[ -f "$codex_cfg" ]] && command -v jq >/dev/null 2>&1; then
            local tmp_codex
            tmp_codex=$(mktemp)
            jq --slurpfile cg "$REPO_ROOT/mcp/codegraph.json" \
               --slurpfile eg "$REPO_ROOT/mcp/engram.json" \
               '.mcpServers.codegraph = {type: $cg[0].transport, command: $cg[0].command, args: $cg[0].args} |
                .mcpServers.engram = {type: $eg[0].transport, command: $eg[0].command, args: $eg[0].args}' \
               "$codex_cfg" > "$tmp_codex" && mv "$tmp_codex" "$codex_cfg"
            printf '  %b[OK]%b Merged MCP servers into %s\n' "$C_GREEN" "$C_RESET" "$codex_cfg"
          else
            cmd_mcp config codex > "$codex_cfg"
            printf '  %b[OK]%b Created %s\n' "$C_GREEN" "$C_RESET" "$codex_cfg"
          fi
          cmd_rules assemble "$codex_rules" >/dev/null
          printf '  %b[OK]%b Installed rules in %s\n' "$C_GREEN" "$C_RESET" "$codex_rules"
        fi
        ;;
      opencode)
        local opencode_cfg="${HOME}/.config/opencode/opencode.json"
        local opencode_rules="${HOME}/.config/opencode/AGENTS.md"
        if (( dry_run )); then
          printf '  [DRY-RUN] Would update MCP servers in %s\n' "$opencode_cfg"
          printf '  [DRY-RUN] Would compile rules to %s\n' "$opencode_rules"
        else
          mkdir -p "$(dirname "$opencode_cfg")"
          if [[ -f "$opencode_cfg" ]] && command -v jq >/dev/null 2>&1; then
            local tmp_opencode
            tmp_opencode=$(mktemp)
            jq --slurpfile cg "$REPO_ROOT/mcp/codegraph.json" \
               --slurpfile eg "$REPO_ROOT/mcp/engram.json" \
               '.mcpServers.codegraph = {type: $cg[0].transport, command: $cg[0].command, args: $cg[0].args} |
                .mcpServers.engram = {type: $eg[0].transport, command: $eg[0].command, args: $eg[0].args}' \
               "$opencode_cfg" > "$tmp_opencode" && mv "$tmp_opencode" "$opencode_cfg"
            printf '  %b[OK]%b Merged MCP servers into %s\n' "$C_GREEN" "$C_RESET" "$opencode_cfg"
          else
            cmd_mcp config opencode > "$opencode_cfg"
            printf '  %b[OK]%b Created %s\n' "$C_GREEN" "$C_RESET" "$opencode_cfg"
          fi
          cmd_rules assemble "$opencode_rules" >/dev/null
          printf '  %b[OK]%b Installed rules in %s\n' "$C_GREEN" "$C_RESET" "$opencode_rules"
        fi
        ;;
    esac
  done

  printf '\n'
  success "Setup completed successfully."
}

case "$COMMAND" in
  plan)
    cmd_plan
    ;;
  doctor)
    cmd_doctor
    ;;
  status)
    cmd_status
    ;;
  rules)
    cmd_rules "$@"
    ;;
  mcp)
    cmd_mcp "$@"
    ;;
  skills)
    cmd_skills "$@"
    ;;
  setup)
    cmd_setup "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    error "unknown command '$COMMAND'"
    usage >&2
    exit 2
    ;;
esac
